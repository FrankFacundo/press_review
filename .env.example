# Copy to `.env` and fill in your own credentials.
# WORT credentials are also used for luxtimes.lu and as fallback for contacto.lu.
WORT_USERNAME=your.email@example.com
WORT_PASSWORD=your_password_here
LESSENTIEL_EMAIL=your.email@example.com
LESSENTIEL_PASSWORD=your_password_here
CONTACTO_EMAIL=your.email@example.com
CONTACTO_PASSWORD=your_password_here

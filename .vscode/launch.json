{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "luxnews debug-search (rtl.lu BNP)",
      "type": "python",
      "request": "launch",
      "module": "luxnews.cli",
      "args": [
        "debug-search",
        "--media",
        "paperjam.lu",
        "--keyword",
        "BNP Paribas",
        "--last-days",
        "2",
        "--headed",
        "--pause"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "luxnews debug-search (infos.rtl.lu)",
      "type": "python",
      "request": "launch",
      "module": "luxnews.cli",
      "args": [
        "debug-search",
        "--media",
        "infos.rtl.lu",
        "--keyword",
        "bgl bnp",
        "--business-days-before",
        "1",
        "--cutoff-hour",
        "9"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "luxnews debug-search (rtl.lu)",
      "type": "python",
      "request": "launch",
      "module": "luxnews.cli",
      "args": [
        "debug-search",
        "--media",
        "rtl.lu",
        "--keyword",
        "bgl bnp",
        "--business-days-before",
        "1",
        "--cutoff-hour",
        "9"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
